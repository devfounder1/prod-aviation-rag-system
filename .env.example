# Exact model identifier loaded in Ollama (enable its local server).
LLM_MODEL_NAME=qwen2.5:14b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# Approximate tool-message character window; does not resize Ollama's token context.
AGENT_CONTEXT_CHARS=16000
AGENT_MAX_STEPS=30
# Separate output budget for grounded document explanations in SEARCH and AGENT.
DOCUMENT_ANSWER_MAX_TOKENS=4096
# Automatic local image analysis; the chat model stays selected.
VISION_MODEL_NAME=qwen2.5vl:7b
VISION_MAX_TOKENS=512
CHROMA_PERSIST_DIR=./data/chroma
LEGACY_CHROMA_DIR=./chroma_db_prl27
DOCUMENTS_DIR=./documents_ae
EMBEDDER_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDER_DEVICE=mps
