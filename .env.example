# Путь к папке с документами (абсолютный или относительный)
DOCUMENTS_DIR=/Users/mihail/Documents/ALMAZ_AI/documents_ae

# Путь для сохранения векторной базы
CHROMA_PERSIST_DIR=./chroma_db_prl27

# Настройки LLM (для локального LM Studio)
LLM_MODEL_NAME=google/gemma-4-12b
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Настройки эмбеддингов
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=mps